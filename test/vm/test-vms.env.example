# Example of the private test VM registry. The real one is ~/.config/test-vms.env (mode 600),
# outside the repo. Everything below is a placeholder: .invalid hostnames and fake tokens only.
# Never put a real hostname, address, VM id or token in this repo.

PVE_MAIN_URL=https://pve.lab.invalid:8006
PVE_MAIN_TOKEN_ID=lab@pve!example
PVE_MAIN_TOKEN_SECRET=00000000-fake-fake-fake-000000000000

VMS="DEB13 U2404 U2604 TK"

TVM_DEB13_PURPOSE="debian-13 journey"
TVM_DEB13_PVE=MAIN
TVM_DEB13_NODE=pve1
TVM_DEB13_VMID=9001
TVM_DEB13_SSH_HOST=deb13.lab.invalid
TVM_DEB13_SSH_USER=root
TVM_DEB13_SNAPSHOT=clean
TVM_DEB13_FEATURES="amd64"
TVM_DEB13_NOTES="Debian 13 netinstall"

TVM_U2404_PURPOSE="ubuntu-24.04 journey"
TVM_U2404_PVE=MAIN
TVM_U2404_NODE=pve1
TVM_U2404_VMID=9002
TVM_U2404_SSH_HOST=u2404.lab.invalid
TVM_U2404_SSH_USER=root
TVM_U2404_SNAPSHOT=clean

TVM_U2604_PURPOSE="ubuntu-26.04 journey"
TVM_U2604_PVE=MAIN
TVM_U2604_NODE=pve1
TVM_U2604_VMID=9003
TVM_U2604_SSH_HOST=u2604.lab.invalid
TVM_U2604_SSH_USER=root
TVM_U2604_SNAPSHOT=clean

# TurnKey has two snapshots. A per-VM TVM_<NAME>_TOKEN_ID and TVM_<NAME>_TOKEN_SECRET also work.
# TVM_<NAME>_OS (debian-13, ubuntu-24.04, ubuntu-26.04 or turnkey) names the OS outright and must equal
# it exactly (ubuntu-24.04-ci is not ubuntu-24.04). Without it the journey looks for the OS in
# PURPOSE and FEATURES, then NOTES; "LTS 24" and "LTS 26" also count for the two Ubuntu releases.
TVM_TK_PURPOSE="turnkey journey"
TVM_TK_PVE=MAIN
TVM_TK_NODE=pve1
TVM_TK_VMID=9004
TVM_TK_SSH_HOST=tk.lab.invalid
TVM_TK_SSH_USER=root
TVM_TK_SNAPSHOT="clean-core clean-nodejs"
